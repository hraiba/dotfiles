# Everforst theme
# --- Completion menu ---
set completion-group-bg         "#343F44"   # bg1
set completion-group-fg         "#D3C6AA"   # fg
set completion-bg               "#2D353B"   # bg0
set completion-fg               "#D3C6AA"
set completion-highlight-bg     "#7FBBB3"   # blue
set completion-highlight-fg     "#232A2E"   # bg_dim (dark text on light blue for contrast)

# --- Notifications ---
set notification-error-bg       "#E67E80"   # red
set notification-error-fg       "#232A2E"
set notification-warning-bg     "#DBBC7F"   # yellow
set notification-warning-fg     "#232A2E"
set notification-bg             "#343F44"   # bg1
set notification-fg             "#D3C6AA"

# --- Index / list ---
set index-bg                    "#232A2E"   # bg_dim
set index-fg                    "#D3C6AA"
set index-active-bg             "#3D484D"   # bg2
set index-active-fg             "#D3C6AA"

# --- Input bar ---
set inputbar-bg                 "#343F44"
set inputbar-fg                 "#D3C6AA"

# --- Status bar ---
set statusbar-bg                "#2D353B"
set statusbar-fg                "#D3C6AA"

# --- Highlights ---
# set highlight-color             "#7FBBB3"   # blue
set highlight-active-color      "#A7C080"   # green

# --- Main colors ---
set default-bg                  "#232A2E"   # bg_dim
set default-fg                  "#D3C6AA"   # fg
set recolor-lightcolor          "#2D353B"
set recolor-darkcolor           "#D3C6AA"

set statusbar-h-padding 0
set statusbar-v-padding 0
set page-padding 1
map u scroll half-up
map d scroll half-down
map D toggle_page_mode
map r reload
map R rotate
map K zoom in
map J zoom out
map i recolor
set recolor                     true
map p print
set selection-clipboard clipboard
