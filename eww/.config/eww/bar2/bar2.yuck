;; Main Window
(defwindow bar2
  :monitor 1
  :class "low-battery"
  :geometry (geometry :x "0%"
                      :y "0%"
                      :height "25%"
                      :width "50%"
                      :anchor "center")
  :stacking "overlay"
  :exclusive false
  :focusable false
  :namespace "eww-bar"
  (battery)
)

(defwidget battery []

  (box
    :orientation "v"
      :class "low-battery"
    (button 
      :valign "start"
      :halign "end"
      :vexpand: false
      :hexpand false
      :width 30
      :height 30
      :onclick "eww close bar2"
      (label 
        :class "close"
        :text "x")
      )
    (label
      :text "Battery capacity less than 10%"
    )

    (button
        :height 50
        :width 100
      :onclick "systemctl poweroff"
      (label
        :class "text"
        :text "Shutdown"
      )
    )
  )
)
