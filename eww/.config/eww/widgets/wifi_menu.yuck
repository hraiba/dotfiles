
;; window with Args 

(defwindow wifi_menu  []
           :monitor 1
           :geometry (geometry 
                        :x "25%"
                        :y "50px"
                        :width "350px"
                        :height "250px")
          :stacking "overlay"
          :reserve (struts :distance "50px" :side "top")
  (eventbox :onfocuslost "eww close wifi_menu"
  (box 
      (wifis 
                :class "wifi_menu"
                :geometry (geometry 
                    :x "0%"
                    :y "42px"
                    :width "300px"
                    :height "250px")
  ))))


(defwidget wifis []
  (box :orientation "h"
       :space-evenly false
       :spacing 12
    (label :class "icon" :text network_icon)
    )

)
